<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: bright glass with a soft blue-white luminous ring instead of a hard border. -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#F0DCE6FF" />
            <stroke android:width="3dp" android:color="#8CA9C3FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Resting: translucent frosted glass, lighter at the top like light catching the edge. -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#14DCE6FF" />
            <stroke android:width="1dp" android:color="#52FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
